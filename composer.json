{
    "name": "a2zwebltd/nova-role-manager",
    "description": "A Laravel Nova tool for managing Spatie roles and permissions with optional audit logging.",
    "keywords": [
        "laravel",
        "nova",
        "spatie",
        "permissions",
        "roles",
        "rbac",
        "auditing"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Nikita V",
            "email": "nikita@a2zweb.co"
        },
        {
            "name": "A2Z Web Ltd",
            "email": "dawid@a2zweb.co"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-permission": "^5.0|^6.0|^7.0|^8.0",
        "a2zwebltd/auditable-relations": "^1.0",
        "owen-it/laravel-auditing": "^13.0|^14.0"
    },
    "require-dev": {
        "laravel/nova": "^5.0"
    },
    "repositories": [
        { "type": "composer", "url": "https://nova.laravel.com" }
    ],
    "autoload": {
        "psr-4": {
            "A2ZWeb\\NovaRoleManager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "A2ZWeb\\NovaRoleManager\\ToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
